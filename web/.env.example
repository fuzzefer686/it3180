# Local: npm run dev tự khởi động Docker stack, sinh web/.env.local và tạo user demo.
# Không cần copy file này để chạy local. Xem docs/supabase-local.md.
# Cloud: sửa web/.env.local bằng URL/key public từ Connect của project,
# rồi chạy npm run dev:web (không chạy npm run dev cho cloud).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_PUBLISHABLE_OR_ANON_KEY
# Client map key; VietMap REST key chỉ để trong Edge Function secrets.
VITE_VIETMAP_MAP_KEY=
