# Vite mặc định dùng các giá trị Emulator này nếu chưa có .env.local.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-vecung
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-vecung.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FUNCTIONS_REGION=asia-southeast1
# Chỉ người 3 cần client key dành cho map web. REST key giữ ở Functions.
VITE_VIETMAP_MAP_KEY=
