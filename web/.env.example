# Frontend dùng Supabase online: điền URL/key public của project vào web/.env.local,
# rồi chạy npm run dev:web. Không điền secret/service-role key.
# Pages cần cùng URL/key trong environment variables khi build.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Backend/test Docker local: npm run dev tự sinh cấu hình local.
# Bản build phát hành không chấp nhận URL Supabase localhost.
# Client map key; VietMap REST key chỉ để trong Edge Function secrets.
VITE_VIETMAP_MAP_KEY=
