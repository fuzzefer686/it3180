{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node", "vite/client"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts", "tests/**/*.tsx",
    "vitest*.mts",
    "shared/**/*.ts"
  ]
}
