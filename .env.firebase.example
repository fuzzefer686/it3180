# Copy thành .env.firebase.dev hoặc .env.firebase.production-demo tại root.
# Chỉ Web config, không đặt service-account JSON/password/VietMap REST key.
# Check/build được phép khi guard false; deploy cần lead bật sau khi có billing.
ENABLE_FIREBASE_DEPLOY=false
FIREBASE_DEPLOY_ENV=dev
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_USE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
VITE_FUNCTIONS_REGION=asia-southeast1
VITE_VIETMAP_MAP_KEY=
