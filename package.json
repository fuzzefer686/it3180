{
  "name": "vecung",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "npm run supabase:start && npm run seed:local && npm run dev:web",
    "dev:web": "npm run dev --workspace web",
    "supabase:start": "tsx scripts/start-local.ts && npm run local:env",
    "supabase:stop": "supabase stop",
    "local:env": "tsx scripts/local-env.ts",
    "seed:local": "tsx scripts/seed-local.ts",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace web",
    "preview": "npm run preview --workspace web",
    "typecheck": "npm run typecheck --workspace web && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:local": "npm test && npm run test:integration",
    "check": "npm run typecheck && npm run build && npm test && npm run test:integration",
    "deploy:check": "node scripts/check-deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "supabase": "2.120.0",
    "@supabase/supabase-js": "2.117.2"
  }
}
